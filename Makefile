TOOLS := $(CURDIR)/.tools
export GOWORK := off
export PATH := $(TOOLS):$(PATH)

.PHONY: tools generate check test test-fixtures race build agent-linux-arm64

tools:
	GOBIN=$(TOOLS) go install github.com/bufbuild/buf/cmd/buf@v1.50.0
	GOBIN=$(TOOLS) go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.6
	GOBIN=$(TOOLS) go install connectrpc.com/connect/cmd/protoc-gen-connect-go@v1.18.1

generate:
	buf lint
	buf generate

check:
	buf lint
	buf build -o /dev/null
	go vet ./...
	cd integrations/ssh && go vet ./...
	cd integrations/ec2 && go vet ./...
	cd integrations/gcp && go vet ./...
	cd integrations/kubernetes && go vet ./...
	cd integrations/skycompat && go vet ./...

test:
	go test ./...
	cd integrations/ssh && go test ./...
	cd integrations/ec2 && go test ./...
	cd integrations/gcp && go test ./...
	cd integrations/kubernetes && go test ./...
	cd integrations/skycompat && go test ./...

# test-fixtures runs the packages whose release-oracle tests need externally
# pinned executables. With SKYGO_REQUIRE_FIXTURES set, a missing pin fails
# instead of skipping; see README.md for the required variables.
test-fixtures:
	SKYGO_REQUIRE_FIXTURES=1 go test -count=1 ./internal/cli ./internal/rpc ./internal/store

race:
	go test -race ./...
	cd integrations/ssh && go test -race ./...
	cd integrations/ec2 && go test -race ./...
	cd integrations/gcp && go test -race ./...
	cd integrations/kubernetes && go test -race ./...
	cd integrations/skycompat && go test -race ./...

build:
	CGO_ENABLED=0 go build -o bin/skygo ./cmd/skygo
	cd integrations/ssh && CGO_ENABLED=0 go build ./...
	cd integrations/ssh && CGO_ENABLED=0 go build -o ../../bin/skygo-ssh ./cmd/skygo-ssh
	cd integrations/ec2 && CGO_ENABLED=0 go build ./...
	cd integrations/gcp && CGO_ENABLED=0 go build -o ../../bin/skygo-gce ./cmd/skygo-gce
	cd integrations/kubernetes && CGO_ENABLED=0 go build -o ../../bin/skygo-kubernetes ./cmd/skygo-kubernetes
	cd integrations/skycompat && CGO_ENABLED=0 go build ./...
	cd integrations/skycompat && CGO_ENABLED=0 go build -o ../../bin/skycompat ./cmd/skycompat

# The commit and digest supplied by the operator are separate provenance inputs.
agent-linux-arm64:
	cd integrations/ssh && GOOS=linux GOARCH=arm64 CGO_ENABLED=0 GOWORK=off go build -trimpath -buildvcs=false -o ../../bin/skygo-ssh-linux-arm64 ./cmd/skygo-ssh
	chmod 0555 bin/skygo-ssh-linux-arm64
